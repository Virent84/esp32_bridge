  "beamformer": {
    "method": "mvdr",
    "diag_loading": 0.05,
    "cov_smoothing": 0.98,
    "max_slew_deg_per_s": 240,
    "hysteresis_deg": 6
  },
  "output": {
    "playback": false,
    "device": "default",
    "gain_db": 0,
    "record_wav": ""
  },
  "dashboard": {
    "host": "0.0.0.0",
    "port": 8080
  },
  "sim": {
    "target_deg": 60,
    "interferer_deg": 200,
    "snr_db": 15,
    "move": true
  }
